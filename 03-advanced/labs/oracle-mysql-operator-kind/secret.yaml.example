# 로컬 실습 전용 자격 증명 템플릿.
# 사용법: cp secret.yaml.example secret.yaml 후 rootPassword를 원하는 값으로 바꾼다.
# secret.yaml은 .gitignore에 의해 커밋되지 않는다.
apiVersion: v1
kind: Secret
metadata:
  name: my-cluster-secret
  namespace: mysql-lab
stringData:
  rootUser: root
  rootHost: '%'
  rootPassword: CHANGE_ME_local_lab_password
